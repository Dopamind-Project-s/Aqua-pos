# Mail-only template for this project's Laravel 12 config/mail.php.
# Merge into the server's existing .env; do not replace the whole .env.
# Replace placeholders using the provider's secure settings. Preserve valid secrets.
# This file contains no working credentials and does not enable SMTP by itself.

MAIL_MAILER=smtp
# For provider STARTTLS on port 587, use smtp (Symfony negotiates STARTTLS).
MAIL_SCHEME=smtp
MAIL_HOST="REPLACE_WITH_PROVIDER_SMTP_HOST"
MAIL_PORT=587
MAIL_USERNAME="REPLACE_WITH_PROVIDER_SMTP_USERNAME"
MAIL_PASSWORD="REPLACE_WITH_PROVIDER_SMTP_PASSWORD"
MAIL_FROM_ADDRESS="verified-sender@your-domain.example"
MAIL_FROM_NAME="Aqua POS"
DEMO_REQUEST_RECIPIENT="lami@mega-pos.com"

# MAIL_URL, if set, overrides individual SMTP connection settings.
# Use the discrete settings above OR an approved DSN, not conflicting values.
MAIL_URL=null

# If the provider requires implicit TLS on port 465 instead, use BOTH:
# MAIL_SCHEME=smtps
# MAIL_PORT=465

# Optional: provider-approved EHLO hostname; defaults to the APP_URL hostname.
# MAIL_EHLO_DOMAIN="mail.your-domain.example"

# This project's config does not read MAIL_ENCRYPTION; use MAIL_SCHEME above.
# After updating the real .env: php artisan config:cache
